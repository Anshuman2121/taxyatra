{
  "name": "taxyatra",
  "productName": "TaxYatra",
  "version": "1.0.0",
  "description": "Tax filing assistant application",
  "private": true,
  "scripts": {
    "dev": "cd backend && tauri dev",
    "dev:web": "vite --config vite.renderer.config.ts",
    "build": "npm run build:sidecar && cd backend && tauri build",
    "build:windows": "npm run build:sidecar:all && cd backend && tauri build --target x86_64-pc-windows-msvc",
    "build:web": "vite build --config vite.renderer.config.ts",
    "build:sidecar": "cd sidecar && npm run build:pkg",
    "build:sidecar:all": "cd sidecar && npm run build:pkg:all",
    "build:sidecar:win": "cd sidecar && npm run build:pkg:win",
    "start": "npm run dev",
    "lint": "eslint --ext .ts,.tsx ."
  },
  "keywords": [
    "tax",
    "finance",
    "itr"
  ],
  "author": {
    "name": "anshuman2121",
    "email": "anshuman2121@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "pkg": "^5.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.16",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  }
}